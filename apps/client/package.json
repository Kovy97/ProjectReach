{
  "name": "@hearthforge/client",
  "version": "1.3.0",
  "description": "Grim Reach — Electron + React Client",
  "author": "Heartforge Studio",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "electron-vite build && electron-builder --win",
    "package:steam": "electron-vite build && electron-builder --win zip",
    "package:scenebuilder": "node scripts/package-scenebuilder.mjs",
    "ui-audit:fixtures": "tsx ui-audit/gen-fixtures.mjs",
    "ui-audit": "node ui-audit/tour.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "@hearthforge/content": "workspace:*",
    "@hearthforge/engine": "workspace:*",
    "@hearthforge/persistence": "workspace:*",
    "@hearthforge/shared": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^32.2.7",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "three": "^0.185.1",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
