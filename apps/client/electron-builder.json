{
  "appId": "com.hearthforge.idle",
  "productName": "Grim Reach",
  "copyright": "Copyright © 2026 Heartforge Studio",
  "directories": {
    "buildResources": "resources",
    "output": "release"
  },
  "files": [
    "out/**",
    "!out/**/*.map",
    "!out/renderer/ui-audit-fixtures/**",
    "!out/renderer/assets/arena_*.webp",
    "!node_modules/**",
    "node_modules/steamworks.js/**",
    "package.json"
  ],
  "asar": true,
  "win": {
    "icon": "resources/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "asarUnpack": [
    "node_modules/steamworks.js/**"
  ],
  "extraFiles": [
    {
      "from": "node_modules/steamworks.js/dist/win64/steam_api64.dll",
      "to": "steam_api64.dll"
    }
  ]
}
